# ============================================================
# SeatLock — Environment Variables Template
# Copy this file to .env for local development.
# In production (Render), configure these in the Render Dashboard.
# NEVER commit .env to Git.
# ============================================================

# --- Application Mode ---
APP_ENV=development          # 'development' for local dev (HTTP), 'production' on Render (HTTPS)

# --- PostgreSQL Connection ---
# Option 1: Full connection URL (Used automatically on Render via DATABASE_URL)
# DATABASE_URL=postgresql://seatlock_user:password@host:5432/seatlock_db

# Option 2: Individual connection parameters (Used for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatlock
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Authentication & JWT Security ---
# Secret key used to sign and verify HMAC-SHA256 JWT tokens.
# Must be at least 32 characters long. Generate a cryptographically random string for production.
JWT_SECRET_KEY=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cookie Security ---
AUTH_COOKIE_NAME=seatlock_access_token
# Leave unset or false for local HTTP development. Set to true in production with HTTPS.
AUTH_COOKIE_SECURE=false
# 'lax' for same-origin or local development; 'none' for cross-domain on *.onrender.com
AUTH_COOKIE_SAMESITE=lax

# --- CORS Allowed Origins ---
# Comma-separated list or JSON array of allowed frontend URLs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seatlock-frontend.onrender.com
CORS_ALLOW_ALL_RENDER=true

# --- Frontend Preview Server ---
# Target backend API URL (only needed when frontend runs separately from backend)
BACKEND_URL=http://localhost:8000

# --- Seed Test Users (RBAC) ---
SEED_STUDENT_USERNAME=student_user
SEED_STUDENT_PASSWORD=StudentPass123!
SEED_ORGANIZER_USERNAME=organizer_user
SEED_ORGANIZER_PASSWORD=OrganizerPass123!
SEED_ADMIN_USERNAME=admin_user
SEED_ADMIN_PASSWORD=AdminPass123!
