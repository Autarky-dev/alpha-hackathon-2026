# ============================================================
# SeatLock — environment variable template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ============================================================

# --- PostgreSQL connection ---
# Individual fields — the application assembles the URL itself
# so credentials are never written as a single visible string.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seatlock
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Application ---
APP_ENV=development          # development | production

# --- Authentication & JWT ---
JWT_SECRET_KEY=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=seatlock_access_token
AUTH_COOKIE_SECURE=false      # Set to true in production with HTTPS
AUTH_COOKIE_SAMESITE=lax

# --- Seed Test Users ---
SEED_STUDENT_USERNAME=student_user
SEED_STUDENT_PASSWORD=StudentPass123!
SEED_ORGANIZER_USERNAME=organizer_user
SEED_ORGANIZER_PASSWORD=OrganizerPass123!
SEED_ADMIN_USERNAME=admin_user
SEED_ADMIN_PASSWORD=AdminPass123!

